# ── Environment ──────────────────────────────────────────────────────
# GENERATED by scripts/gen-env-example.js from agent-backend/env-config.js.
# Edit the table there, not this file.
#
# Copy to `.env` and fill in. Everything is optional EXCEPT an LLM endpoint
# (set it here or in the app's Settings; Settings wins).
#
# Variable names carry NO product name, deliberately — a rebrand never touches
# your .env, CI config or secret manager. See docs/rebranding.md.
#
# IMPORTANT for Docker: compose's `env_file` does NOT strip inline "# ..."
# comments the way dotenv does — keep comments on their OWN lines, or a value
# like DASHBOARD_ORIGIN will silently include the comment text.

# ── Core ──
# Backend port (bare-metal only; Docker forces it).
PORT=6800

# Bind host. Set 0.0.0.0 only behind a proxy on another host — then
# AUTH_SUPERADMIN_KEY is mandatory.
# HOST=127.0.0.1

# Dashboard origin (CORS + OIDC redirect base).
DASHBOARD_ORIGIN=http://localhost:6801

# Public origin harnesses/agents reach this app at. Pins pairing/harness URLs
# so a proxy mis-setting X-Forwarded-Proto can't break the harness WebSocket.
# APP_PUBLIC_ORIGIN=

# Where per-session workspaces live. Default: ~/.tether
# APP_HOME=

# Base URL used by the E2E harness (tests only).
# APP_URL=

# ── LLM (any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Together, Ollama, vLLM, a proxy, …) ──
# Upstream OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Together,
# Ollama, vLLM, a proxy, …). Leave blank if you have none yet — the UI will
# prompt.
LLM_BASE_URL=

# Upstream API key. Held server-side; spawned agents never see it.
LLM_API_KEY=

# Default model for the fast/balanced effort tiers.
LLM_FAST_MODEL=

# Default model for the deep effort tier and plan generation. Falls back to
# LLM_FAST_MODEL.
LLM_REASONING_MODEL=

# Invert precedence: env wins over Settings, and the LLM fields render
# read-only. For locked-down deployments.
# LLM_CONFIG_LOCKED=

# Output cap for the optional pre-plan call.
# LLM_PLAN_MAX_TOKENS=600

# Client timeout for the optional pre-plan call.
# LLM_PLAN_TIMEOUT_MS=20000

# ── Access control (RBAC + multi-tenancy) ──
# Superadmin BEARER credential. UNSET MEANS AUTH IS BYPASSED (local dev-mode:
# every caller is superadmin). Set it before exposing the server beyond
# loopback.
# AUTH_SUPERADMIN_KEY=

# Username for the seeded browser sign-in account.
# AUTH_SUPERADMIN_USERNAME=admin

# Password for that account. If unset, a random one is generated and printed
# once at first boot.
# AUTH_SUPERADMIN_PASSWORD=

# ── Enterprise SSO (OIDC — OPTIONAL; toggle on from Admin › SSO once set) ──
# OIDC issuer. Works with Entra, Okta, Google, Auth0, Keycloak, …
# OIDC_ISSUER_URL=

# OIDC client id.
# OIDC_CLIENT_ID=

# OIDC client secret.
# OIDC_CLIENT_SECRET=

# Default <DASHBOARD_ORIGIN>/api/auth/sso/callback.
# OIDC_REDIRECT_URI=

# Requested scopes.
# OIDC_SCOPES=openid email profile

# Comma-separated; these sign in as tenant-admins.
# OIDC_ADMIN_EMAILS=

# Comma-separated; restrict sign-in to these email domains.
# OIDC_ALLOWED_DOMAINS=

# ── Database ──
# Postgres connection string. Present → the postgres driver is selected.
# DATABASE_URL=

# Force a driver (sqlite|postgres) regardless of DATABASE_URL.
# DB_DRIVER=

# SQLite file location. Default: agent-backend/tether.db
# DB_PATH=

# Postgres pool size.
# DB_PG_POOL_MAX=10

# ── Harness binaries (auto-discovered on PATH; override if needed) ──
# Path to the `pi` binary. Auto-discovered on PATH if unset.
# HARNESS_PI_PATH=

# Path to the node binary that runs pi. Deliberately NOT Node's own NODE_PATH,
# which means something else entirely.
# HARNESS_NODE_PATH=

# Path to the `opencode` binary for the optional OpenCode harness.
# HARNESS_OPENCODE_PATH=

# ── Execution sandbox (containment for agent shell/tools) ──
# Where a session runs when nothing specifies one: host | container | remote.
# SANDBOX_DEFAULT=host

# Container sandbox image (ships python + node).
# SANDBOX_IMAGE=nikolaik/python-nodejs:python3.12-nodejs22-slim

# missing (default) | never (air-gapped) | always.
# SANDBOX_PULL=missing

# Container network. Non-host isolates net and publishes host.docker.internal.
# SANDBOX_NETWORK=host

# Mount the host harness config dir (~/.pi) read-only to protect its auth.
# SANDBOX_HARNESS_CONFIG_RO=

# Host gateway name used from inside containers.
# SANDBOX_HOST_GATEWAY=host.docker.internal

# ── Run API (headless task submission → result contract) ──
# Sandbox for /api/run when the request/profile doesn't set one. Defaults to
# container, downgrading to host without Docker.
# RUN_SANDBOX=

# Abort a run after this long with no harness events (hang detection).
# RUN_IDLE_MS=180000

# Absolute backstop per run.
# RUN_MAX_MS=1200000

# How long a run parks at awaiting_input before returning a no-answer
# sentinel.
# RUN_ASK_TIMEOUT_MS=600000

# External build+test facility /grade endpoint. Unset → the end_build handoff
# is inert.
# RUN_TESTER_URL=

# Bearer token sent to that facility.
# RUN_TESTER_KEY=

# ── Secrets / tokens encryption-at-rest ──
# AES-256-GCM key material for stored secrets and OAuth tokens. STRONGLY
# recommended in Docker: unset means a random key file, and a container
# recreate without a persistent volume mints a new key and orphans every
# encrypted value.
# APP_SECRET=

# Where the auto-generated key is persisted when APP_SECRET is unset. Default:
# $APP_HOME/.tether-secret
# APP_SECRET_FILE=

# ── Optional services ──
# Lightpanda browser CDP endpoint.
# LIGHTPANDA_WS=ws://127.0.0.1:9222

# TTS endpoint. The voice UI only appears when this is set.
# LOCAL_TTS_URL=

# TTS key.
# LOCAL_TTS_KEY=

# TTS model.
# LOCAL_TTS_MODEL=pocket-tts

# Backend for pi's native web_search.
# EXA_API_KEY=

# Backend for pi's native web_search.
# PERPLEXITY_API_KEY=

# Backend for pi's native web_search.
# GEMINI_API_KEY=

# Disable the Telegram poller entirely.
# TELEGRAM_DISABLE=

# Per-device LLM spend cap. 0 = unlimited.
# APP_DEVICE_LLM_BUDGET=0

# Reported OS label for a paired device.
# APP_OS=

# ── Internal LLM gateway (set by the app; override only if you know why) ──
# App-local credential agents use against the internal /llm/v1 gateway.
# Auto-generated per boot; pin only if you need it stable.
# GATEWAY_KEY=

# Internal gateway URL. Defaults to http://127.0.0.1:<PORT>/llm/v1.
# GATEWAY_URL=

# Set by the app on a spawned agent. Not operator config.
# GATEWAY_BASE_URL=

# Set by the app on a spawned agent. Not operator config.
# GATEWAY_API_KEY=

# Set by the app on a spawned agent. Not operator config.
# GATEWAY_MODEL=

# ── agent ──
# Injected into built-in MCP servers so session-blind tools can identify the
# lead session.
# AGENT_SESSION_ID=

# Backend base URL an MCP server or adapter calls back on.
# AGENT_API_URL=http://127.0.0.1:6800

# Credential an MCP server or adapter presents on that callback.
# AGENT_API_KEY=

# Policy mode (chat|plan|edit|yolo) for a spawned agent.
# AGENT_MODE=

# Override the agent binary the remote adapter launches.
# AGENT_CMD=

# Extra args for that binary.
# AGENT_ARGS=

# Which agent kind the remote adapter connects as.
# AGENT_CONNECT_KIND=

# State directory for the remote adapter.
# AGENT_ADAPTER_HOME=

# ── Migrating from an older release ──
# Variable names changed to brand-free, functional prefixes. The app FAILS AT
# BOOT on a legacy name rather than silently defaulting — an unset
# AUTH_SUPERADMIN_KEY means auth-bypass dev mode, so a silent fallback would
# boot a deployment wide open. To rewrite an existing file in place:
#   node scripts/migrate-env.js .env --dry-run
#   node scripts/migrate-env.js .env
